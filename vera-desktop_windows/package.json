{
  "name": "vera-desktop",
  "version": "1.0.0",
  "description": "VERA desktop resume-screening application",
  "main": "main.cjs",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.vera.resume.screening",
    "productName": "VERA",
    "files": [
      "main.cjs"
    ],
    "extraResources": [
      {
        "from": "../vera-engine/dist/vera-api",
        "to": "backend"
      },
      {
        "from": "../vera-frontend/.next/standalone",
        "to": "frontend"
      },
      {
        "from": "../vera-frontend/.next/standalone/node_modules",
        "to": "frontend/node_modules"
      },
      {
        "from": "../vera-frontend/.next/static",
        "to": "frontend/.next/static"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
 